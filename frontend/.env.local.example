# Local development: the separately running backend.
# On Vercel leave this UNSET: the browser then calls /api/v1 on the same domain,
# and server-side code uses BACKEND_URL, injected by the service binding in /vercel.json.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
